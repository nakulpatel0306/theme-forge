exports[`neovim output is stable 1`] = `
"-- Kanagawa Dragon, generated by theme-forge

vim.cmd('highlight clear')
vim.o.background = 'dark'
vim.g.colors_name = 'kanagawa-dragon'

local c = {
  bg = '#181616',
  surface = '#282727',
  overlay = '#393836',
  muted = '#625e5a',
  fg = '#c5c9c5',
  red = '#c4746e',
  orange = '#b6927b',
  yellow = '#c4b28a',
  green = '#8a9a7b',
  cyan = '#8ea4a2',
  blue = '#8ba4b0',
  magenta = '#a292a3',
}

local groups = {
  Normal = { fg = c.fg, bg = c.bg },
  NormalFloat = { fg = c.fg, bg = c.surface },
  FloatBorder = { fg = c.overlay, bg = c.surface },
  Cursor = { fg = c.bg, bg = c.fg },
  CursorLine = { bg = '#222020' },
  CursorLineNr = { fg = c.yellow, bold = true },
  LineNr = { fg = c.muted },
  SignColumn = { bg = c.bg },
  ColorColumn = { bg = c.surface },
  Visual = { bg = c.overlay },
  Search = { fg = c.bg, bg = c.yellow },
  IncSearch = { fg = c.bg, bg = c.orange },
  CurSearch = { link = 'IncSearch' },
  MatchParen = { fg = c.orange, bold = true },
  StatusLine = { fg = c.fg, bg = c.surface },
  StatusLineNC = { fg = c.muted, bg = c.surface },
  TabLine = { fg = c.muted, bg = c.surface },
  TabLineSel = { fg = c.fg, bg = c.bg },
  TabLineFill = { bg = c.surface },
  WinSeparator = { fg = c.overlay },
  Pmenu = { fg = c.fg, bg = c.surface },
  PmenuSel = { fg = c.fg, bg = c.overlay, bold = true },
  PmenuSbar = { bg = c.surface },
  PmenuThumb = { bg = c.overlay },
  Folded = { fg = c.muted, bg = c.surface },
  NonText = { fg = c.overlay },
  EndOfBuffer = { fg = c.overlay },
  Whitespace = { fg = c.overlay },
  Title = { fg = c.blue, bold = true },
  Directory = { fg = c.blue },
  ErrorMsg = { fg = c.red },
  WarningMsg = { fg = c.yellow },
  MoreMsg = { fg = c.green },
  Question = { fg = c.cyan },
  Comment = { fg = c.muted, italic = true },
  Constant = { fg = c.orange },
  String = { fg = c.green },
  Character = { fg = c.green },
  Number = { fg = c.orange },
  Boolean = { fg = c.orange },
  Float = { fg = c.orange },
  Identifier = { fg = c.fg },
  Function = { fg = c.blue },
  Statement = { fg = c.magenta },
  Keyword = { fg = c.magenta, italic = true },
  Conditional = { fg = c.magenta },
  Repeat = { fg = c.magenta },
  Exception = { fg = c.magenta },
  Operator = { fg = c.cyan },
  PreProc = { fg = c.magenta },
  Include = { fg = c.magenta },
  Type = { fg = c.yellow },
  StorageClass = { fg = c.magenta },
  Structure = { fg = c.yellow },
  Special = { fg = c.cyan },
  Delimiter = { fg = c.fg },
  Todo = { fg = c.bg, bg = c.yellow, bold = true },
  Error = { fg = c.red },
  ['@variable'] = { fg = c.fg },
  ['@variable.member'] = { fg = c.fg },
  ['@property'] = { fg = c.fg },
  ['@punctuation'] = { fg = c.fg },
  DiffAdd = { bg = '#2d2e28' },
  DiffChange = { bg = '#292b2d' },
  DiffDelete = { fg = c.red, bg = '#372726' },
  DiffText = { bg = '#3b4144' },
  Added = { fg = c.green },
  Changed = { fg = c.blue },
  Removed = { fg = c.red },
  GitSignsAdd = { fg = c.green },
  GitSignsChange = { fg = c.blue },
  GitSignsDelete = { fg = c.red },
  DiagnosticError = { fg = c.red },
  DiagnosticWarn = { fg = c.yellow },
  DiagnosticInfo = { fg = c.blue },
  DiagnosticHint = { fg = c.cyan },
  DiagnosticOk = { fg = c.green },
  DiagnosticUnderlineError = { sp = c.red, undercurl = true },
  DiagnosticUnderlineWarn = { sp = c.yellow, undercurl = true },
  DiagnosticUnderlineInfo = { sp = c.blue, undercurl = true },
  DiagnosticUnderlineHint = { sp = c.cyan, undercurl = true },
}

for name, spec in pairs(groups) do
  vim.api.nvim_set_hl(0, name, spec)
end

vim.g.terminal_color_0 = '#282727'
vim.g.terminal_color_1 = '#c4746e'
vim.g.terminal_color_2 = '#8a9a7b'
vim.g.terminal_color_3 = '#c4b28a'
vim.g.terminal_color_4 = '#8ba4b0'
vim.g.terminal_color_5 = '#a292a3'
vim.g.terminal_color_6 = '#8ea4a2'
vim.g.terminal_color_7 = '#acaeaa'
vim.g.terminal_color_8 = '#625e5a'
vim.g.terminal_color_9 = '#cd8984'
vim.g.terminal_color_10 = '#9ca98f'
vim.g.terminal_color_11 = '#cdbe9c'
vim.g.terminal_color_12 = '#9cb2bc'
vim.g.terminal_color_13 = '#b0a2b1'
vim.g.terminal_color_14 = '#9fb2b0'
vim.g.terminal_color_15 = '#c5c9c5'
"
`;


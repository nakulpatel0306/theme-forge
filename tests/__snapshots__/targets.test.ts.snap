      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#c5c9c5"
      }
    },
    {
      "name": "markup.inserted",
      "scope": [
        "markup.inserted"
      ],

exports[`delta output is stable 1`] = `
"# Kanagawa Dragon, generated by theme-forge

[delta "kanagawa-dragon"]
  dark = true
  syntax-theme = kanagawa-dragon
  minus-style = syntax "#372726"
  minus-emph-style = syntax "#543735"
  plus-style = syntax "#2d2e28"
  plus-emph-style = syntax "#404439"
  line-numbers-minus-style = "#c4746e"
  line-numbers-plus-style = "#8a9a7b"
  line-numbers-zero-style = "#625e5a"
  line-numbers-left-style = "#393836"
  line-numbers-right-style = "#393836"
  file-style = "#8ba4b0" bold
  file-decoration-style = "#8ba4b0" ul
  hunk-header-style = file line-number syntax
  hunk-header-decoration-style = "#393836" box
  hunk-header-line-number-style = "#c4b28a"
  hunk-header-file-style = "#8ba4b0"
  commit-style = "#c4b28a" bold
  commit-decoration-style = "#c4b28a" box
  blame-palette = "#181616 #282727 #393836"
"
`;

